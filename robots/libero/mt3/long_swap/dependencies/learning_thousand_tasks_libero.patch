+    def _to_hwc(image: np.ndarray) -> np.ndarray:
+        """Images may come channels-first (C, H, W) or, as SceneState stores them, (H, W, C)."""
+        if image.ndim == 3 and image.shape[-1] == 3:
+            return image
+        return image.transpose(1, 2, 0)
